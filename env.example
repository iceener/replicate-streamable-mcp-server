# Bun server
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# MCP identity and fetch-native endpoint
MCP_NAME="Replicate"
MCP_TITLE="Replicate"
MCP_VERSION=1.0.0
MCP_INSTRUCTIONS="Search Replicate models before generating when model parameters are unknown."
MCP_PUBLIC_URL=http://localhost:3000/mcp
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
MCP_ALLOWED_ORIGIN_HOSTNAMES=localhost,127.0.0.1,[::1]
MCP_LEGACY_MODE=stateless
MCP_MAX_REQUEST_BYTES=1048576

# MCP caller credential. If unset, caller authentication is disabled for local use.
# Accepted as Authorization: Bearer <key> or X-Api-Key: <key>.
API_KEY=

# Server-side Replicate provider credential. It is never derived from API_KEY.
REPLICATE_API_TOKEN=
