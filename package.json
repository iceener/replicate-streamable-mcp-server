{
  "name": "replicate-mcp",
  "version": "1.0.0",
  "description": "MCP server for Replicate - AI image generation and editing",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "dev:worker": "wrangler dev",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "build:worker": "wrangler deploy --dry-run --outdir dist/worker",
    "deploy": "wrangler deploy",
    "deploy:tail": "wrangler tail",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "types:worker": "wrangler types --env-file /dev/null",
    "types:worker:check": "wrangler types --env-file /dev/null --check",
    "test": "bun test",
    "test:protocol": "bun test tests/protocol.test.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "replicate",
    "image-generation",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0-beta.5",
    "hono": "^4.11.7",
    "replicate": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@cloudflare/workers-types": "^5.20260727.1",
    "@modelcontextprotocol/client": "2.0.0-beta.5",
    "@types/node": "^24.10.0",
    "bun-types": "latest",
    "typescript": "^5.9.3",
    "wrangler": "^4.114.0"
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=20.0.0"
  }
}
